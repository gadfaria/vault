<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent: starts go2rtc at login and restarts it if it stops. Paths are filled in by the README's install command. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vault.go2rtc</string>
  <key>ProgramArguments</key>
  <array>
    <string>GO2RTC_BIN</string>
    <string>-config</string>
    <string>BRIDGE_DIR/go2rtc.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>BRIDGE_DIR/go2rtc.log</string>
  <key>StandardErrorPath</key>
  <string>BRIDGE_DIR/go2rtc.log</string>
</dict>
</plist>
